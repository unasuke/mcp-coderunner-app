<h1>Jobs</h1>

<table>
  <thead>
    <tr><th>id</th><th>state</th><th>profile</th><th>blueprint</th><th>結果</th><th>作成</th></tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= link_to job.id, admin_job_path(job) %></td>
        <td><%= job.state %></td>
        <td><%= job.profile %></td>
        <td><%= link_to job.blueprint.name, admin_blueprint_path(job.blueprint) %></td>
        <td><%= job.job_result&.termination_reason %> <%= job.job_result&.exit_code %></td>
        <td><%= job.created_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
