<% content_for :title, "実行環境" %>

<div class="sheet">
  <h1>実行環境 <span class="h1-sub"><%= @blueprints.size %> 件</span></h1>

  <%# Subscribing belongs to the browser you are holding, so it lives on the page
      where reviews happen rather than in a per-account setting %>
  <% if Notifications::Push.configured? %>
    <div class="actions" data-controller="push"
         data-push-public-key-value="<%= Rails.configuration.x.mcp_coderunner_app.vapid_public_key %>">
      <button type="button" data-push-target="button" data-action="push#toggle">
        このブラウザで通知を受け取る
      </button>
      <span class="dim" data-push-target="state"></span>
    </div>
  <% end %>

  <% if @blueprints.empty? %>
    <div class="empty">
      <p>まだ実行環境がありません。</p>
      <p>MCP クライアントから <code class="mono">propose_blueprint</code> で提案すると、ここにレビュー待ちとして並びます。</p>
    </div>
  <% else %>
    <div class="rows-scroll">
      <table class="rows">
        <thead>
          <tr>
            <th>#</th>
            <th>名前</th>
            <th>用途</th>
            <th>状態</th>
            <th>digest</th>
            <th class="num">context</th>
            <th>提案</th>
          </tr>
        </thead>
        <tbody>
          <% @blueprints.each do |blueprint| %>
            <tr class="<%= "needs-review" if blueprint.pending_review? %>">
              <td><%= link_to blueprint.id, admin_blueprint_path(blueprint), class: "mono" %></td>
              <td><%= link_to blueprint.name, admin_blueprint_path(blueprint) %></td>
              <td><%= blueprint.summary %></td>
              <td class="nowrap"><%= state_tag(blueprint.state) %></td>
              <td><%= short(blueprint.digest) %></td>
              <td class="num dim"><%= blueprint.blueprint_files.size %> ファイル</td>
              <td class="dim nowrap"><%= blueprint.created_by&.login %> <%= since(blueprint.created_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
