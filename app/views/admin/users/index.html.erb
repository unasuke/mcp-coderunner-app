<% content_for :title, "ユーザー" %>

<div class="sheet sheet-narrow">
  <h1>ユーザー <span class="h1-sub"><%= @users.size %> 人</span></h1>

  <p class="dim">
    承認待ちのユーザーにできることはありません。
    <code class="mono">member</code> にすると MCP から実行環境とジョブを扱えるようになり、
    <code class="mono">admin</code> にするとこの管理画面も開けます。
  </p>

  <div class="rows-scroll">
    <table class="rows">
    <thead>
      <tr><th>GitHub</th><th>ロール</th><th>承認</th><th>操作</th></tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="<%= "needs-review" if user.pending? %>">
          <td class="nowrap">
            <%= user.login %>
            <% if user.name.present? && user.name != user.login %>
              <span class="dim"><%= user.name %></span>
            <% end %>
          </td>
          <td><%= state_tag(user.role) %></td>
          <td class="dim">
            <% if user.approved_at %>
              <%= user.approved_by&.login %> <%= since(user.approved_at) %>
            <% else %>
              —
            <% end %>
          </td>
          <td>
            <div class="actions">
              <%# The last admin cannot be demoted: nothing here could be approved afterwards %>
              <% User.roles.keys.reject { |role| role == user.role }.each do |role| %>
                <% next unless user.demotable_to?(role) %>
                <%= button_to role_action_label(role), admin_user_path(user, role:), method: :patch,
                      class: ("btn-go" if role == "member"),
                      form: { data: { turbo_confirm: ("#{user.login} を承認待ちに戻します。開いているセッションも切れます。" if role == "pending") } } %>
              <% end %>
              <% if user.last_admin? %>
                <span class="dim">最後の admin のため変更できません</span>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
    </table>
  </div>
</div>
