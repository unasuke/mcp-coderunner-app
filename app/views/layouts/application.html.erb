<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= [ content_for(:title), "mcp-coderunner-app" ].compact.join(" — ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Revisiting the same URL -- a job page refreshing itself -- is applied as a diff,
        which is what keeps the scroll position %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <%# Browsers that can take the SVG use it. It is the emoji itself, so it holds up at
        any size and does not care what color the tab is. The PNG is for everything else,
        and for the home screen %>
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <% if Current.user %>
      <header class="bar">
        <span class="bar-mark"><span class="bar-glyph" aria-hidden="true">📋</span>mcp-coderunner-app</span>

        <nav>
          <%= link_to "ジョブ", admin_jobs_path, "aria-current": ("page" if controller_path == "admin/jobs") %>
          <%= link_to "実行環境", admin_blueprints_path, "aria-current": ("page" if controller_path == "admin/blueprints") %>
          <%= link_to "ユーザー", admin_users_path, "aria-current": ("page" if controller_path == "admin/users") %>
          <%= link_to "ワーカー", admin_workers_path, "aria-current": ("page" if controller_path == "admin/workers") %>
        </nav>

        <div class="bar-side">
          <%= worker_pulse %>
          <span class="bar-who"><%= Current.user.login %>（<%= Current.user.role %>）</span>
          <%= button_to "ログアウト", logout_path, method: :delete %>
        </div>
      </header>
    <% end %>

    <main>
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
