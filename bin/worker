#!/usr/bin/env ruby
# frozen_string_literal: true

# 自宅 VM で動かす常駐プロセス。systemd から起動する。
# 単発実行のサブコマンドは持たない（手で叩く用途は bin/mcp_stdio が持つ）。

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "json"
require "optparse"
require "securerandom"
require "socket"
require "protocol/constants"
require "protocol/job_result"
require "worker/client"
require "worker/docker"
require "worker/policy"
require "worker/runner"

module Worker
  class Agent
    DEFAULT_CONFIG = "/etc/mcprb/config.yml"
    DEFAULT_REVISION = "/opt/mcprb/REVISION"
    BACKOFF_MAX = 30

    def initialize(config_path:, revision_path:)
      @policy = Policy.load(config_path)
      @commit_hash = read_revision(revision_path)
      @instance_id = SecureRandom.uuid_v7
      @client = Client.new(policy: @policy)
      @running = true
      @draining = false
      @jobs = {}
      @mutex = Mutex.new
    end

    def run
      trap_signals
      register
      heartbeat_thread = start_heartbeat
      lease_loop
      heartbeat_thread.kill
      shutdown
      0
    end

    private

    # 終了処理の順序は「新規 lease を止める → 実行中のコンテナを片付ける → /deregister を打つ」。
    # コンテナを落とす前に離脱を通知すると、サーバーが再投入したジョブと古いコンテナが並走する。
    def shutdown
      log("shutdown.begin", jobs: @mutex.synchronize { @jobs.size })
      @mutex.synchronize { @jobs.values }.each { |thread| thread.join(90) }
      deregister
      @client.close
    end

    def trap_signals
      %w[ TERM INT ].each do |signal|
        Signal.trap(signal) { @running = false }
      end
    end

    # サーバーがまだ起きていないことがある（bin/dev で並べて起動する場合など）。
    # 落ちて再起動を待つより、繋がるまで待つほうが素直。
    def register
      backoff = 1

      begin
        response = @client.register(
          instance_id: @instance_id,
          commit_hash: @commit_hash,
          capacity: @policy.max_concurrency,
          hostname: Socket.gethostname,
          pid: Process.pid,
          ruby_version: RUBY_VERSION,
          docker_version: docker_version
        )
        log("register", instance_id: @instance_id, outdated: response["outdated"])
      rescue Error => e
        raise unless @running

        log("register.failed", error: e.message, backoff:)
        sleep backoff
        backoff = [ backoff * 2, BACKOFF_MAX ].min
        retry
      end
    end

    def deregister
      @client.deregister(instance_id: @instance_id, reason: "shutdown")
      log("deregister", instance_id: @instance_id)
    rescue Error => e
      # ベストエフォート。届かなければ heartbeat の失効判定が拾う
      log("deregister.failed", error: e.message)
    end

    def start_heartbeat
      Thread.new do
        client = Client.new(policy: @policy)
        while @running
          begin
            response = client.heartbeat(instance_id: @instance_id, commit_hash: @commit_hash)
            @draining = !!response["drain"]
          rescue Error => e
            log("heartbeat.failed", error: e.message)
          end
          sleep Protocol::Constants::HEARTBEAT_INTERVAL
        end
      ensure
        client&.close
      end
    end

    def lease_loop
      backoff = 1

      while @running
        if @draining || busy?
          sleep Protocol::Constants::LEASE_POLL_INTERVAL
          next
        end

        begin
          payload = @client.lease(instance_id: @instance_id)
          backoff = 1
          start_job(payload) if payload
        rescue Client::ProtocolMismatch => e
          # 勝手に exit するとクラッシュループになる。止めるだけにする
          log("lease.protocol_mismatch", error: e.message)
          @draining = true
        rescue Error => e
          log("lease.failed", error: e.message, backoff:)
          sleep backoff
          backoff = [ backoff * 2, BACKOFF_MAX ].min
        end
      end
    end

    def busy?
      @mutex.synchronize { @jobs.size } >= @policy.max_concurrency
    end

    # ロックを握ったまま起こす。子スレッドの ensure は @jobs への登録が
    # 済むまでロックを取れないので、登録前に削除されることがない。
    def start_job(payload)
      @mutex.synchronize do
        @jobs[payload.job_id] = Thread.new { run_job(payload) }
      end
    end

    def run_job(payload)
      log("job.start", job_id: payload.job_id, digest: payload.blueprint.digest, profile: payload.profile)
      client = Client.new(policy: @policy)
      cancelled = [ false ]
      heartbeat = start_job_heartbeat(payload, client, cancelled)

      result = Runner.new(policy: @policy).call(payload, cancelled: -> { cancelled[0] })
      heartbeat.kill

      accepted = client.post_result(job_id: payload.job_id, lease_token: payload.lease_token, result:)
      log("job.finish", job_id: payload.job_id, reason: result.termination_reason,
        exit_code: result.exit_code, duration_ms: result.duration_ms, accepted:)
    rescue StandardError => e
      # 結果を返さずに終わると、リースが失効するまでジョブが宙吊りになる
      log("job.failed", job_id: payload.job_id, error: "#{e.class}: #{e.message}")
      report_worker_error(client, payload, e)
    ensure
      client&.close
      @mutex.synchronize { @jobs.delete(payload.job_id) }
    end

    def report_worker_error(client, payload, error)
      return unless client

      client.post_result(
        job_id: payload.job_id,
        lease_token: payload.lease_token,
        result: Protocol::JobResult.new(
          termination_reason: "worker_error",
          stderr: "#{error.class}: #{error.message}"
        )
      )
    rescue StandardError => e
      log("job.result.failed", job_id: payload.job_id, error: "#{e.class}: #{e.message}")
    end

    # 最初の 1 回はすぐ打つ。サーバーはこれを受け取って state を running に移す。
    def start_job_heartbeat(payload, client, cancelled)
      Thread.new do
        loop do
          begin
            response = client.job_heartbeat(job_id: payload.job_id, lease_token: payload.lease_token)
            cancelled[0] = true if response["cancel"]
          rescue Error => e
            log("job.heartbeat.failed", job_id: payload.job_id, error: e.message)
          end
          sleep Protocol::Constants::HEARTBEAT_INTERVAL
        end
      end
    end

    def docker_version
      result = Docker.run("version", "--format", "{{.Server.Version}}")
      result.success? ? result.stdout.strip : nil
    end

    # 空のファイルや読めないパスでも register は通す。ずれの検知が効かなくなるだけで、
    # ワーカーが起動できないほどのことではない
    def read_revision(path)
      revision = File.read(path).strip
      revision.empty? ? "unknown" : revision
    rescue SystemCallError
      "unknown"
    end

    def log(event, **payload)
      $stdout.puts(JSON.generate({ event:, worker_id: @policy.worker_id }.merge(payload)))
      $stdout.flush
    end
  end
end

options = { config: Worker::Agent::DEFAULT_CONFIG, revision: Worker::Agent::DEFAULT_REVISION }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/worker [options]"
  parser.on("--config PATH", "設定ファイル（既定: #{options[:config]}）") { |v| options[:config] = v }
  parser.on("--revision PATH", "REVISION ファイル（既定: #{options[:revision]}）") { |v| options[:revision] = v }
end.parse!(ARGV)

exit Worker::Agent.new(config_path: options[:config], revision_path: options[:revision]).run
