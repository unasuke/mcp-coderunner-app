#!/usr/bin/env ruby
# frozen_string_literal: true

# The long-running process on the home VM, started by systemd.
# It has no one-shot subcommands. To run something by hand, send it through the
# MCP endpoint like anything else.

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "json"
require "optparse"
require "securerandom"
require "socket"
require "protocol/constants"
require "protocol/job_result"
require "worker/client"
require "worker/docker"
require "worker/job_registry"
require "worker/policy"
require "worker/runner"

module Worker
  class Agent
    DEFAULT_CONFIG = "/etc/mcp-coderunner-app/config.yml"
    DEFAULT_REVISION = "/opt/mcp-coderunner-app/REVISION"
    BACKOFF_MAX = 30

    # How long to wait on jobs in flight. Stays inside the unit's TimeoutStopSec=90
    SHUTDOWN_GRACE = 60

    def initialize(config_path:, revision_path:)
      @policy = Policy.load(config_path)
      @commit_hash = read_revision(revision_path)
      @instance_id = SecureRandom.uuid_v7
      @client = Client.new(policy: @policy)
      @jobs = JobRegistry.new(max_concurrency: @policy.max_concurrency)
      @leasing = true
      @beating = true
      @draining = false
    end

    def run
      trap_signals
      register
      heartbeat = start_heartbeat
      lease_loop

      # Shutdown order: stop taking leases, clear the containers still running,
      # then /deregister. Announcing the departure before the containers are down
      # leaves the job the server requeues running alongside the old container
      drain_jobs
      stop_heartbeat(heartbeat)
      deregister
      @client.close
      0
    end

    private

    # Inside a trap, only set a flag. Taking a lock here can deadlock
    def trap_signals
      %w[ TERM INT ].each do |signal|
        Signal.trap(signal) { @leasing = false }
      end
    end

    # The server may not be up yet (when bin/dev starts both at once, say).
    # Waiting until it answers is more honest than dying and waiting to be restarted.
    def register
      backoff = 1

      begin
        response = @client.register(
          instance_id: @instance_id,
          commit_hash: @commit_hash,
          capacity: @policy.max_concurrency,
          hostname: Socket.gethostname,
          pid: Process.pid,
          ruby_version: RUBY_VERSION,
          docker_version: docker_version
        )
        log("register", instance_id: @instance_id, outdated: response["outdated"])
      rescue Error => e
        raise unless @leasing

        log("register.failed", error: e.message, backoff:)
        sleep backoff
        backoff = [ backoff * 2, BACKOFF_MAX ].min
        retry
      end
    end

    def deregister
      @client.deregister(instance_id: @instance_id, reason: "shutdown")
      log("deregister", instance_id: @instance_id)
    rescue Error => e
      # Best-effort. If it never lands, heartbeat expiry picks it up
      log("deregister.failed", error: e.message)
    end

    # Keeps beating through shutdown. So the reaper does not claim this instance
    # during a 90-second cleanup, it runs until just before deregister
    def start_heartbeat
      Thread.new do
        client = Client.new(policy: @policy)

        while @beating
          begin
            response = client.heartbeat(instance_id: @instance_id, commit_hash: @commit_hash)
            @draining = !!response["drain"]
          rescue Error => e
            log("heartbeat.failed", error: e.message)
          end

          nap(Protocol::Constants::HEARTBEAT_INTERVAL) { @beating }
        end
      ensure
        client&.close
      end
    end

    def stop_heartbeat(thread)
      @beating = false
      thread.join(5)
    end

    def lease_loop
      backoff = 1

      while @leasing
        if @draining || @jobs.busy?
          sleep Protocol::Constants::LEASE_POLL_INTERVAL
          next
        end

        begin
          payload = @client.lease(instance_id: @instance_id)
          backoff = 1
          start_job(payload) if payload
        rescue Client::ProtocolMismatch => e
          # Exiting on our own would make a crash loop. Just stop taking work
          log("lease.protocol_mismatch", error: e.message)
          @draining = true
        rescue Error => e
          log("lease.failed", error: e.message, backoff:)
          sleep backoff
          backoff = [ backoff * 2, BACKOFF_MAX ].min
        end
      end
    end

    def start_job(payload)
      entry = @jobs.add(payload)

      if entry.nil?
        log("job.refused", job_id: payload.job_id, lease_id: payload.lease_id)
        return
      end

      entry.thread = Thread.new { run_job(entry) }
    end

    def run_job(entry)
      payload = entry.payload
      log("job.start", job_id: payload.job_id, lease_id: payload.lease_id,
        digest: payload.blueprint.digest, profile: payload.profile)

      # The heartbeat and the result do not share a connection. Client is not thread-safe
      heartbeat_client = Client.new(policy: @policy)
      heartbeat = start_job_heartbeat(entry, heartbeat_client)
      result_client = Client.new(policy: @policy)

      await_exclusive_slot(entry)
      result = Runner.new(policy: @policy).call(payload, cancelled: -> { entry.cancelled? })

      # No Thread#kill. Breaking the socket mid-send means the result never arrives
      entry.stop_heartbeat!
      heartbeat.join(5)

      accepted = result_client.post_result(
        job_id: payload.job_id, lease_token: payload.lease_token, result:
      )
      log("job.finish", job_id: payload.job_id, reason: result.termination_reason,
        exit_code: result.exit_code, duration_ms: result.duration_ms, accepted:)
    rescue StandardError => e
      # Finishing without sending a result leaves the job hanging until the lease expires
      log("job.failed", job_id: payload.job_id, error: "#{e.class}: #{e.message}")
      report_worker_error(result_client, payload, e)
    ensure
      entry.stop_heartbeat!
      heartbeat_client&.close
      result_client&.close
      @jobs.delete(payload.lease_id)
    end

    # bench never runs alongside another job. The server holds this too, but
    # waiting here as well keeps a drifted VPS from ruining the measurement
    def await_exclusive_slot(entry)
      return unless entry.exclusive?

      until @jobs.alone?(entry) || entry.cancelled?
        log("job.waiting_for_exclusive", job_id: entry.job_id, running: @jobs.size)
        sleep Protocol::Constants::LEASE_POLL_INTERVAL
      end
    end

    # The first beat goes out immediately: it is what moves the server-side state to running.
    def start_job_heartbeat(entry, client)
      Thread.new do
        while entry.beating?
          begin
            response = client.job_heartbeat(
              job_id: entry.job_id, lease_token: entry.payload.lease_token
            )
            entry.cancel! if response["cancel"]
          rescue Error => e
            log("job.heartbeat.failed", job_id: entry.job_id, error: e.message)
          end

          nap(Protocol::Constants::HEARTBEAT_INTERVAL) { entry.beating? }
        end
      end
    end

    def report_worker_error(client, payload, error)
      return unless client

      client.post_result(
        job_id: payload.job_id,
        lease_token: payload.lease_token,
        result: Protocol::JobResult.new(
          termination_reason: "worker_error",
          stderr: "#{error.class}: #{error.message}"
        )
      )
    rescue StandardError => e
      log("job.result.failed", job_id: payload.job_id, error: "#{e.class}: #{e.message}")
    end

    # After SIGTERM, leaving is only allowed once the running containers are down
    def drain_jobs
      entries = @jobs.entries
      return if entries.empty?

      log("shutdown.cancelling", jobs: entries.size)
      entries.each(&:cancel!)

      deadline = monotonic + SHUTDOWN_GRACE
      entries.each { |entry| entry.thread&.join([ deadline - monotonic, 0 ].max) }

      sweep_containers
    end

    # Whatever outlasted the wait is cleared by label, the same sweep the unit runs
    # before it starts and after it stops
    def sweep_containers
      listed = Docker.run("ps", "-aq", "--filter", "label=#{Protocol::Constants::CONTAINER_LABEL}")
      containers = listed.stdout.split
      return if containers.empty?

      log("shutdown.sweep", containers: containers.size)
      Docker.run("rm", "--force", "--volumes", *containers)
    end

    # Sleep in small pieces, so a shutdown is noticed while napping
    def nap(seconds)
      seconds.times do
        break unless yield

        sleep 1
      end
    end

    def monotonic
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    def docker_version
      result = Docker.run("version", "--format", "{{.Server.Version}}")
      result.success? ? result.stdout.strip : nil
    end

    # An empty file or an unreadable path still registers. All that is lost is
    # drift detection, which is not worth refusing to start over
    def read_revision(path)
      revision = File.read(path).strip
      revision.empty? ? "unknown" : revision
    rescue SystemCallError
      "unknown"
    end

    def log(event, **payload)
      $stdout.puts(JSON.generate({ event:, worker_id: @policy.worker_id }.merge(payload)))
      $stdout.flush
    end
  end
end

options = { config: Worker::Agent::DEFAULT_CONFIG, revision: Worker::Agent::DEFAULT_REVISION }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/worker [options]"
  parser.on("--config PATH", "config file (default: #{options[:config]})") { |v| options[:config] = v }
  parser.on("--revision PATH", "REVISION file (default: #{options[:revision]})") { |v| options[:revision] = v }
end.parse!(ARGV)

exit Worker::Agent.new(config_path: options[:config], revision_path: options[:revision]).run
