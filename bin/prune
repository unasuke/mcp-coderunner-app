#!/usr/bin/env ruby
# frozen_string_literal: true

# Clears out built images. Called from systemd's mcp-coderunner-app-prune.timer.
# Worth having if you pull ruby-head nightly.

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "optparse"
require "worker/builder"
require "worker/policy"

options = { config: "/etc/mcp-coderunner-app/config.yml" }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/prune [options]"
  parser.on("--config PATH", "config file (default: #{options[:config]})") { |v| options[:config] = v }
end.parse!(ARGV)

policy = Worker::Policy.load(options[:config])
Worker::Builder.new(policy:).prune!
