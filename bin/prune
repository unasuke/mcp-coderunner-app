#!/usr/bin/env ruby
# frozen_string_literal: true

# ビルド済みイメージの掃除。systemd の mcprb-prune.timer から呼ぶ。
# ruby-head を毎晩引くなら特に必要になる。

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "optparse"
require "worker/builder"
require "worker/policy"

options = { config: "/etc/mcprb/config.yml" }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/prune [options]"
  parser.on("--config PATH", "設定ファイル（既定: #{options[:config]}）") { |v| options[:config] = v }
end.parse!(ARGV)

policy = Worker::Policy.load(options[:config])
Worker::Builder.new(policy:).prune!
