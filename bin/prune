#!/usr/bin/env ruby
# frozen_string_literal: true

# Clears out what building left behind: images past their TTL, the ones over
# max_images, dangling layers, stopped job containers and BuildKit's cache.
# Called from systemd's mcp-coderunner-app-prune.timer, hourly.

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "json"
require "optparse"
require "worker/builder"
require "worker/policy"

options = { config: "/etc/mcp-coderunner-app/config.yml" }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/prune [options]"
  parser.on("--config PATH", "config file (default: #{options[:config]})") { |v| options[:config] = v }
end.parse!(ARGV)

policy = Worker::Policy.load(options[:config])
summary = Worker::Builder.new(policy:).prune!

# One line per run, in the same shape the worker logs in. It is what says whether
# the disk is going to the images, to the build cache, or to neither
puts JSON.generate({ event: "prune", worker_id: policy.worker_id }.merge(summary))
