#!/usr/bin/env ruby
# frozen_string_literal: true

# フェーズ 2 限りの暫定サーバー。Rails も DB もキューも無しに、worker/ を
# インプロセスで呼んで Dockerfile と script をその場で実行し、同期で結果を返す。
#
# Blueprint の承認も Job のキューイングも持たない。自分の手元で自分が書いた
# Dockerfile を走らせるだけなので、レビューを挟む意味がないため。
# フェーズ 3 に入った時点でこのファイルは削除する。

require "bundler/setup"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), root)

require "json"
require "mcp"
require "optparse"
require "time"
require "tmpdir"
require "protocol/blueprint_digest"
require "protocol/job_payload"
require "protocol/resource_profile"
require "worker/policy"
require "worker/runner"

module McpStdio
  class RunTool < MCP::Tool
    tool_name "run"
    description <<~TEXT
      Dockerfile とスクリプトを受け取り、リソース制限下のコンテナで同期実行して結果を返す。
      実行コンテナはネットワークに出られない（--network none）。ネットワークが要るのは build だけ。
      同じ Dockerfile なら 2 回目以降はビルド済みイメージを使い回す。
    TEXT

    input_schema(
      properties: {
        dockerfile: { type: "string", description: "実行環境の Dockerfile" },
        script: { type: "string", description: "コンテナ内の /work/script.rb に置かれる本体" },
        files: {
          type: "array",
          description: "build context に置くファイル（Gemfile など）",
          items: {
            type: "object",
            properties: {
              path: { type: "string" },
              content: { type: "string" },
              executable: { type: "boolean" }
            },
            required: [ "path", "content" ]
          }
        },
        entrypoint: {
          type: "array",
          description: "省略時は [\"ruby\", \"/work/script.rb\"]",
          items: { type: "string" }
        },
        profile: { type: "string", enum: Protocol::ResourceProfile::NAMES }
      },
      required: [ "dockerfile", "script" ]
    )

    class << self
      attr_accessor :policy

      def call(dockerfile:, script:, files: [], entrypoint: nil, profile: "default", server_context: nil)
        payload = build_payload(dockerfile:, script:, files:, entrypoint:, profile:)
        result = Worker::Runner.new(policy: policy).call(payload)

        MCP::Tool::Response.new(
          [ { type: "text", text: JSON.pretty_generate(result.to_h) } ],
          error: result.termination_reason != "exited" || result.exit_code != 0
        )
      end

      private

      def build_payload(dockerfile:, script:, files:, entrypoint:, profile:)
        profile = "default" unless Protocol::ResourceProfile.exist?(profile)
        normalized = files.map { |file| file.transform_keys(&:to_s) }

        Protocol::JobPayload.from_h({
          "job_id" => 0,
          "lease_id" => Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond),
          "lease_token" => "local",
          "lease_expires_at" => (Time.now + 3600).utc.iso8601,
          "blueprint" => {
            "digest" => Protocol::BlueprintDigest.compute(dockerfile:, files: normalized),
            "dockerfile" => dockerfile,
            "files" => normalized
          },
          "script" => script,
          "profile" => profile,
          "entrypoint" => entrypoint,
          "limits" => Protocol::ResourceProfile.limits_for(profile).transform_keys(&:to_s)
        }.compact)
      end
    end
  end
end

options = { config: nil, runtime_dir: File.join(Dir.tmpdir, "mcp-sandbox-app") }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/mcp_stdio [options]"
  parser.on("--config PATH", "worker の設定ファイル（省略時は既定値で動く）") { |v| options[:config] = v }
  parser.on("--runtime-dir PATH", "ジョブごとの作業ディレクトリ") { |v| options[:runtime_dir] = v }
end.parse!(ARGV)

McpStdio::RunTool.policy =
  if options[:config]
    Worker::Policy.load(options[:config])
  else
    Worker::Policy.new(worker_id: "local", endpoint: "https://unused.invalid", runtime_dir: options[:runtime_dir])
  end

server = MCP::Server.new(
  name: "mcp-sandbox-app-local",
  title: "Ruby exec sandbox (local)",
  version: "0.1.0",
  instructions: "任意の Dockerfile 上で Ruby スクリプトを隔離実行する。ベンチマークや Ractor の挙動確認向け。",
  tools: [ McpStdio::RunTool ]
)

MCP::Server::Transports::StdioTransport.new(server).open
