# 経路ごとに分ける。Anthropic のレンジは変わりうるので、環境変数に切り出して
# 1 箇所の更新で済むようにしておく。
#
#   ANTHROPIC_RANGES="1.2.3.0/24 5.6.7.0/24" caddy run

(anthropic_only) {
	route {
		# 弾くときは 403 ではなく 404。そこに MCP エンドポイントがあること自体を伏せる
		@blocked not remote_ip {$ANTHROPIC_RANGES}
		respond @blocked 404
		reverse_proxy localhost:3000
	}
}

mcp-sandbox-app.example.com {
	encode zstd gzip

	# Anthropic のクラウドからのみ到達できる面
	handle /mcp* {
		import anthropic_only
	}
	handle /oauth/token* {
		import anthropic_only
	}
	handle /oauth/register* {
		import anthropic_only
	}

	# ブラウザから。認可の関門はアプリ側の require_member!
	handle /oauth/authorize* {
		reverse_proxy localhost:3000
	}
	handle /admin* {
		reverse_proxy localhost:3000
	}
	handle /login* {
		reverse_proxy localhost:3000
	}
	handle /auth/* {
		reverse_proxy localhost:3000
	}

	# ワーカーから。自宅が固定 IP ならここも絞る
	handle /api/worker/* {
		reverse_proxy localhost:3000
	}

	# メタデータは公開のまま（RFC 9728 / RFC 8414）
	handle {
		reverse_proxy localhost:3000
	}
}

# remote_ip を使う（client_ip ではない）。Caddy が edge に立っているので、
# 判定すべきは TCP の接続元。client_ip は X-Forwarded-For を見るため、
# trusted_proxies を設定していない状態では詐称できてしまう。
