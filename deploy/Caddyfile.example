# Split by path. Anthropic's ranges can change, so they are pulled out into an
# environment variable and updated in one place.
#
#   ANTHROPIC_RANGES="1.2.3.0/24 5.6.7.0/24" caddy run
#
# localhost:8080 is kamal-proxy, which picks the application by the Host header.

(anthropic_only) {
	route {
		# Refused with a 404 rather than a 403, so that an MCP endpoint being here is not itself news
		@blocked not remote_ip {$ANTHROPIC_RANGES}
		respond @blocked 404
		reverse_proxy localhost:8080
	}
}

mcp-coderunner-app.example.com {
	encode zstd gzip

	# The surface reachable only from Anthropic's cloud
	handle /mcp* {
		import anthropic_only
	}
	handle /oauth/token* {
		import anthropic_only
	}
	handle /oauth/register* {
		import anthropic_only
	}

	# From a browser. The gate is require_member! in the application
	handle /oauth/authorize* {
		reverse_proxy localhost:8080
	}
	handle /admin* {
		reverse_proxy localhost:8080
	}
	handle /login* {
		reverse_proxy localhost:8080
	}
	handle /auth/* {
		reverse_proxy localhost:8080
	}

	# From the worker. With a static address at home, narrow this too
	handle /api/worker/* {
		reverse_proxy localhost:8080
	}

	# The metadata stays public (RFC 9728 / RFC 8414)
	handle {
		reverse_proxy localhost:8080
	}
}

# remote_ip, not client_ip. Caddy stands at the edge here, so what matters is where
# the TCP connection came from. client_ip reads X-Forwarded-For, which without
# trusted_proxies configured can simply be claimed.
