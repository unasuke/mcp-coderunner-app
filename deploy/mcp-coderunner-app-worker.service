[Unit]
Description=mcp-coderunner-app worker (Ruby exec MCP)
# The daemon is rootless, which makes it a systemd *user* service. A system unit
# cannot order itself after one, so there is no dependency to declare here: if the
# worker wins the race at boot it fails its docker calls, Restart=always brings it
# back, and leases return to the queue meanwhile.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-coderunner-app
WorkingDirectory=/opt/mcp-coderunner-app
ExecStart=/usr/bin/ruby /opt/mcp-coderunner-app/bin/worker --config /etc/mcp-coderunner-app/config.yml

# The token is not in the environment. It shows up in neither /proc/PID/environ nor systemctl show
LoadCredential=api_token:/etc/mcp-coderunner-app/token

# DOCKER_HOST lives here, because the rootless socket path carries the user's uid
# and that is only known once the account exists: unix:///run/user/<uid>/docker.sock
EnvironmentFile=-/etc/mcp-coderunner-app/worker.env

# Keep the CLI's own state in the runtime directory. A directory it cannot read is
# worse than one that is not there: Docker 29 takes `build` from the buildx plugin,
# and a plugin directory that answers permission denied costs it that command --
# `docker build --tag` then fails as an unknown top-level flag.
Environment=DOCKER_CONFIG=%t/mcp-coderunner-app/.docker

# An unclean exit leaves job containers behind. They are collected by label.
# systemd does not do command substitution, hence the sh
ExecStartPre=-/bin/sh -c 'docker ps -aq --filter label=mcp-coderunner-app.job | xargs -r docker rm --force --volumes'
ExecStopPost=-/bin/sh -c 'docker ps -aq --filter label=mcp-coderunner-app.job | xargs -r docker rm --force --volumes'

# On SIGTERM the worker clears the running containers before it exits.
# Too short here, and a job hangs until its lease expires
TimeoutStopSec=90
Restart=always
RestartSec=5

RuntimeDirectory=mcp-coderunner-app
StateDirectory=mcp-coderunner-app

# The daemon is rootless, so reaching its socket is no longer the same as being
# root on the VM -- which is what SupplementaryGroups=docker used to mean here.
# The VM is still the boundary this design relies on; the unit now adds to it
# rather than being undone by it.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

# Not ProtectHome=yes: it covers /run/user as well as /home, and the rootless
# daemon's socket lives at /run/user/<uid>/docker.sock. Nothing of the worker's
# is in /home -- the account's home is /var/lib/mcp-coderunner-app.
ProtectHome=no

# A job container belongs to dockerd's cgroup, so MemoryMax here binds the worker
# itself and nothing else. The container's limits are set by docker run's flags
MemoryMax=1G

[Install]
WantedBy=multi-user.target
