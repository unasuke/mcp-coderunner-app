[Unit]
Description=mcp-coderunner-app image prune (hourly)

[Timer]
# The VM's disk is small, so this runs far more often than the TTLs it enforces:
# what a run removes is decided by build.* in config.yml, and running hourly only
# means the space comes back within the hour rather than the day
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
